{
    "browser_specific_settings": {
        "gecko": {
            "id": "dark-mode-express@pharaoh2k",
            "strict_min_version": "78.0",
            "update_url": "https://raw.githubusercontent.com/Pharaoh2k/dark-mode-express/main/updates.json"
        },
        "gecko_android": {}
    },
    "background": {
        "page": "background/index.html"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "inject/index.js"
            ],
            "run_at": "document_start",
            "all_frames": true,
            "match_about_blank": true,
            "world": "ISOLATED"
        }
    ],
    "permissions": [
        "alarms",
        "contextMenus",
        "scripting",
        "storage",
        "tabs",
        "theme",
        "<all_urls>"
    ],
    "optional_permissions": []
}
